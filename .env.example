# Frontpage Feed Reader Environment Configuration

# Port for the local Node server (`pnpm run dev` / `pnpm start`).
# Not used by Vercel, which assigns its own runtime port automatically.
PORT=3000

# Runtime mode: "development" enables the Vite HMR middleware in dev;
# set to "production" when serving the static `dist/` build via `pnpm start`.
NODE_ENV=development
